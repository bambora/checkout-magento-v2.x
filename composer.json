{
    "name": "bambora/module-payment-magento2",
    "description": "Worldline Online Checkout payment module for Magento 2  (previously named Bambora Online Checkout) ",
    "type": "magento2-module",
    "version": "4.0.0",
    "authors": [
        {
            "name": "Bambora Online A/S",
            "email": "support.nordics@worldline.com"
        }
    ],
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "magento/framework": ">=103.0.6 <104.0.0",
        "magento/module-backend": ">=102.0.6 <103.0.0",
        "magento/module-catalog": ">=104.0.6 <105.0.0",
        "magento/module-checkout": ">=100.4.6 <101.0.0",
        "magento/module-config": ">=101.2.6 <102.0.0",
        "magento/module-payment": ">=100.4.6 <101.0.0",
        "magento/module-quote": ">=101.2.6 <102.0.0",
        "magento/module-sales": ">=103.0.6 <104.0.0",
        "magento/module-store": ">=101.1.6 <102.0.0",
        "magento/module-tax": ">=100.4.6 <101.0.0",
        "magento/module-ui": ">=101.2.6 <102.0.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Bambora\\Online\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ]
