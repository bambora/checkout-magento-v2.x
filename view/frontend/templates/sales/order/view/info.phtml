<?php
$specificInfo = $block->getSpecificInformation();
$paymentMethodTitle = $escaper->escapeHtml($block->getMethod()->getTitle());
$paymentInformationTitle = $block->getPaymentInformationTitle();
?>
<dl class="payment-method bambora_checkout">
    <dt class="title">
        <?= /* @noEscape */ $paymentMethodTitle ?>
    </dt>
    <?php
    if ($specificInfo): ?>
    <dt>
        <div style="margin-top:10px; margin-bottom:10px;">
            <h3><?= /* @noEscape */ $paymentInformationTitle ?></h3>
            <table>
                <?php
                foreach ($specificInfo as $label => $value): ?>
                    <tr>
                        <td><b><?= $escaper->escapeHtml($label) ?>:</b></td>
                        <td style="padding-left:10px">
                            <?= /* @noEscape */ nl2br(
                                $escaper->escapeHtml(
                                    implode(
                                        "\n",
                                        $block->getValueAsArray($value, true)
                                    )
                                )
                            ) ?>
                        </td>
                    </tr>
                    <?php
                    endforeach; ?>
            </table>
        </div>
    </dt>
        <?php
        endif; ?>
</dl>
